<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ayepezExamen.Views.vLogin"
             Title="Login">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="10">
            <Image Source="logo.png"
                   WidthRequest="150"
                   HeightRequest="150"/>

            <Label Text="INICIO DE SESIÓN"
                   TextColor="Purple"
                   FontSize="26"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>

            <Grid RowSpacing="10"
                  ColumnSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Label Text="Usuario:"
                       Style="{StaticResource EtiquetaGlobal}"
                       Grid.Row="0"
                       Grid.Column="0"/>
                <Entry x:Name="txtUsuario"
                       Placeholder="Ingresa el usuario"
                       Grid.Row="0"
                       Grid.Column="1"/>

                <Label Text="Contraseña:"
                       Style="{StaticResource EtiquetaGlobal}"
                       Grid.Row="1"
                       Grid.Column="0"/>
                <Entry x:Name="txtContrasena"
                       Placeholder="Ingresa la contraseña"
                       IsPassword="True"
                       Grid.Row="1"
                       Grid.Column="1"/>

                <Button x:Name="btnIniciarSesion"
                        Text="Iniciar sesión"
                        Style="{StaticResource BotonGlobal}"
                        Clicked="btnIniciarSesion_Clicked"
                        Grid.Row="2"
                        Grid.Column="0"/>
                <Button x:Name="btnAcercaDe"
                        Text="Acerca de"
                        Style="{StaticResource BotonGlobal}"
                        Clicked="btnAcercaDe_Clicked"
                        Grid.Row="2"
                        Grid.Column="1"/>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
