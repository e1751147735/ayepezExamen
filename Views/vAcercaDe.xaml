<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ayepezExamen.Views.vAcercaDe"
             Title="Acerca de">

    <VerticalStackLayout
        Padding="20"
        Spacing="10">
        <Label Text="ACERCA DE"
               FontSize="22"
               FontAttributes="Bold"
               HorizontalOptions="Center"/>

        <Grid RowSpacing="10"
              ColumnSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Label Text="Nombre:"
                   Style="{StaticResource EtiquetaGlobal}"
                   Grid.Row="0"
                   Grid.Column="0"/>
            <Label Text="Alexis Fernando Yépez Fuel"
                   Grid.Row="0"
                   Grid.Column="1"/>

            <Label Text="Carrera:"
                   Style="{StaticResource EtiquetaGlobal}"
                   Grid.Row="1"
                   Grid.Column="0"/>
            <Label Text="Ingeniería Informática"
                   Grid.Row="1"
                   Grid.Column="1"/>

            <Label Text="Paralelo:"
                   Style="{StaticResource EtiquetaGlobal}"
                   Grid.Row="2"
                   Grid.Column="0"/>
            <Label Text="A"
                   Grid.Row="2"
                   Grid.Column="1"/>
        </Grid>
    </VerticalStackLayout>
</ContentPage>
